{
  "schema_version": 1,
  "name": "JamPeter Ops Stack",
  "status": "beta",
  "philosophy": "Independent narrow tools composed into a GitHub-first operational lifecycle.",
  "phases": [
    {
      "id": "provision",
      "product": "Issue Repo Admin",
      "repository": "jam2peter/issue-repo-admin",
      "ref": "v0",
      "site": "https://jampeter.com.br/apps/issue-repo-admin/",
      "status": "public"
    },
    {
      "id": "govern",
      "product": "Project V2 Sync",
      "repository": "jam2peter/project-v2-sync",
      "ref": "v0",
      "site": "https://jampeter.com.br/apps/project-v2-sync/",
      "status": "public"
    },
    {
      "id": "schedule",
      "product": "GitHub Agenda Sync",
      "repository": "jam2peter/github-agenda-sync",
      "ref": "v0.1-beta",
      "site": "https://jampeter.com.br/apps/jha-calendar/",
      "status": "public",
      "source_of_truth": "GitHub Issues",
      "projection": [
        "Google Tasks",
        "Google Calendar"
      ]
    },
    {
      "id": "quality",
      "product": "Quality Gate",
      "repository": "jam2peter/quality-gate",
      "ref": "v0",
      "site": "https://jampeter.com.br/apps/quality-gate/",
      "status": "public",
      "output": "quality-report.json + Git state fingerprint"
    },
    {
      "id": "preserve",
      "product": "Auto Checkpoint",
      "repository": "jam2peter/auto-checkpoint",
      "status": "public",
      "ref": "v0",
      "site": "https://jampeter.com.br/apps/auto-checkpoint/"
    },
    {
      "id": "deploy-control",
      "product": "OIDC Site Control",
      "repository": "jam2peter/oidc-site-control",
      "ref": "v0",
      "site": "https://jampeter.com.br/apps/oidc-site-control/",
      "status": "public"
    },
    {
      "id": "deploy-engine",
      "product": "SafeDeploy",
      "repository": "jam2peter/safedeploy",
      "ref": "v0",
      "site": "https://jampeter.com.br/apps/safedeploy/",
      "status": "public"
    },
    {
      "id": "verify",
      "product": "HTTPS Readback",
      "repository": "jam2peter/https-readback",
      "ref": "v0",
      "site": "https://jampeter.com.br/apps/https-readback/",
      "status": "public"
    }
  ],
  "suites": [
    {
      "name": "RepoOps",
      "repository": "jam2peter/repoops",
      "ref": "v0",
      "site": "https://jampeter.com.br/apps/repoops/",
      "contains": [
        "provision",
        "govern"
      ]
    },
    {
      "name": "SafeDeploy",
      "repository": "jam2peter/safedeploy",
      "ref": "v0",
      "site": "https://jampeter.com.br/apps/safedeploy/",
      "integrates": [
        "deploy-control",
        "verify"
      ]
    }
  ],
  "observe": {
    "mode": "cross-cutting",
    "purpose": "Operational assurance across the lifecycle without broadening module permissions.",
    "modules": [
      {
        "id": "audit",
        "capability": "ops.audit-active",
        "product": "JamPeter Ops Audit",
        "repository": "jam2peter/ops-audit",
        "source_repository": "jam2peter/JamPeter-Infrastructure",
        "ref": "main",
        "site": "https://jampeter.com.br/apps/ops-audit/",
        "status": "public-runtime-status",
        "answers": "Is the operational control plane coherent?"
      },
      {
        "id": "monitor",
        "capability": "ops.monitoring",
        "product": "JamPeter Ops Monitor",
        "repository": "jam2peter/ops-monitor",
        "ref": "main",
        "site": "https://jampeter.com.br/apps/ops-monitor/",
        "status": "public-beta",
        "answers": "How is the runtime behaving now?"
      },
      {
        "id": "alert",
        "capability": "ops.watchdog",
        "product": "JamPeter Ops Watchdog",
        "repository": "jam2peter/ops-watchdog",
        "ref": "main",
        "site": "https://jampeter.com.br/apps/ops-watchdog/",
        "status": "public-beta",
        "answers": "Did state change enough to notify a human?"
      }
    ]
  }
}
